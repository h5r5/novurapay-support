# SupportPipe Environment Variables Configuration Example
# Copy this file to .env and fill in your values. Do NOT commit .env.

# LLM Providers Configuration
# Primary general LLM (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback general LLM (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Specialized Decision Model (TypeSafe AI Jev 1.13 / jev-latest)
# You can set either TYPESAFE_API_KEY or JEV_API_KEY
TYPESAFE_API_KEY=your_typesafe_api_key_here
JEV_API_KEY=your_typesafe_api_key_here
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# Pipeline Execution Mode: 'live' (calls real APIs), 'cached' (reads/writes disk cache), 'offline' (mock/template only)
LLM_MODE=offline

# Logging and System
LOG_LEVEL=INFO
PYTHONUTF8=1
